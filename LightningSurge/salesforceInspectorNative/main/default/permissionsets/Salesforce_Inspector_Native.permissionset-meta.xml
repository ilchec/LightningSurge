<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Salesforce Inspector Native</label>
    <description>Grants the app, its tab, and its Apex classes. Field Creator also needs Customize Application, Permissions and Groups also needs Assign Permission Sets and Manage Public Groups, separately - see salesforceInspectorNative/README.md.</description>
    <applicationVisibilities>
        <application>Salesforce_Inspector_Native</application>
        <visible>true</visible>
    </applicationVisibilities>
    <classAccesses>
        <apexClass>InspectorNativeObjectPicker</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>InspectorNativeSoqlRunner</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>InspectorNativeFieldCreator</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>InspectorNativeFieldPermissions</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>InspectorNativePermissionAssignment</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>InspectorNativeOrgInfo</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <tabSettings>
        <tab>Salesforce_Inspector_Native</tab>
        <visibility>Visible</visibility>
    </tabSettings>
</PermissionSet>
